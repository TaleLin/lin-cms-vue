{
  "name": "lin-cms-vue",
  "version": "0.4.3",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "serve": "pnpm dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "pnpm quality:check && pnpm test:run && pnpm build",
    "ci": "pnpm check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "plugin:init": "node script/plugin-init.js",
    "plugin:new": "node script/plugin-new.js",
    "plugin:reconfig": "node script/plugin-get-config.js",
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:style": "stylelint \"**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint \"**/*.{vue,scss,css}\" --fix",
    "lint:staged": "lint-staged",
    "quality:check": "pnpm lint && pnpm lint:style && pnpm format:check",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.0",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.20",
    "element-plus": "^2.13.7",
    "event-source-polyfill": "^1.0.31",
    "fastscan": "^1.0.6",
    "lodash": "^4.18.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "screenfull": "^6.0.2",
    "swiper": "^12.1.3",
    "vue": "^3.5.32",
    "vue-picture-cropper": "^1.0.0",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/compiler-sfc": "^3.5.32",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "chalk": "^4.1.2",
    "directory-tree": "^3.6.0",
    "ejs": "^3.1.10",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "fs-extra": "^11.3.4",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "inquirer": "^8.2.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.2.6",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.2",
    "sass": "^1.99.0",
    "semver": "^7.7.4",
    "shelljs": "^0.10.0",
    "stylelint": "^17.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "validate-npm-package-name": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^10.4.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,vue}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{css,scss,vue}": [
      "stylelint",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": "prettier --check"
  }
}
